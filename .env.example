# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://example.com
PORT=3000

# Database
# Never commit a real credential in this file.
# Set the real value in Coolify environment variables.
DATABASE_URL=postgresql://user:password@host:5432/blablabox

# Authentication uses opaque PostgreSQL sessions and requires no client-side key.
# Production registrations only open when this value is explicitly set to true.
REGISTRATION_ENABLED=false

# Providers
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
# Server-side request timeout, in milliseconds. Allowed range: 5000 to 300000.
LLM_REQUEST_TIMEOUT_MS=120000
WEB_SEARCH_ENABLED=false
TTS_PROVIDER=disabled
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
TTS_MAX_SCRIPT_CHARACTERS=4096
TTS_SEGMENT_TARGET_CHARACTERS=3500
OCR_PROVIDER=disabled
OCR_API_KEY=
OCR_MODEL=gpt-5-mini
SPEECH_TO_TEXT_PROVIDER=disabled
SPEECH_TO_TEXT_API_KEY=

# Course originals stay private and immutable; learning extraction is explicit.
SOURCE_UPLOAD_MAX_BYTES=26214400
# Production: an absolute path on a mounted persistent private volume is required.
# Development only: omit this variable to use ./storage/sources.
SOURCE_STORAGE_ROOT=/data/blablabox/sources

# Future file storage
STORAGE_PROVIDER=local
AUDIO_STORAGE_PATH=./storage/audio

# Error monitoring (optional — leave empty to disable)
# Install: npm install @sentry/nextjs
SENTRY_DSN=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
