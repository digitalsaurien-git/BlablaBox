# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://example.com
PORT=3000

# Database
# Never commit a real credential in this file.
# Set the real value in Coolify environment variables.
DATABASE_URL=postgresql://user:password@host:5432/blablabox

# Future authentication
# Auth is intentionally not implemented in the current MVP lot.
AUTH_SECRET=

# Providers
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
TTS_PROVIDER=disabled
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
TTS_MAX_SCRIPT_CHARACTERS=12000
OCR_PROVIDER=disabled
OCR_API_KEY=
SPEECH_TO_TEXT_PROVIDER=disabled
SPEECH_TO_TEXT_API_KEY=

# Future file storage
STORAGE_PROVIDER=local
AUDIO_STORAGE_PATH=./storage/audio
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
