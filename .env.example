# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Database
# Never commit a real credential in this file.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/blablabox?schema=public

# Future authentication
# Auth is intentionally not implemented in the current MVP lot.
AUTH_SECRET=

# Providers
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
TTS_PROVIDER=disabled
TTS_API_KEY=
OCR_PROVIDER=disabled
OCR_API_KEY=
SPEECH_TO_TEXT_PROVIDER=disabled
SPEECH_TO_TEXT_API_KEY=

# Future file storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
