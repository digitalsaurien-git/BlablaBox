generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  SCRIPT_GENERATED
  SCRIPT_FAILED
}

enum AudioStatus {
  NOT_GENERATED
  PENDING
  GENERATED
  FAILED
}

enum DeliveryType {
  IMMERSIVE_STORY
  COURSE_SUMMARY
  MEMORY_AUDIO_CARD
  REVIEW_QA
}

enum ProjectKind {
  LEGACY_AUDIO
  UNDERSTAND_LISTEN
  DICTATE_WRITE
  COURSE_LEARNING
}

enum ResponseMode {
  EXPLAIN
  STORY
  REVIEW
  QUICK
}

enum VocabularyLevel {
  VERY_SIMPLE
  COMMON
  PRECISE
}

enum AdaptationMode {
  STANDARD
  FOCUS
  EASY_READING
  MEMORY
}

enum ResearchMode {
  NONE
  AUTO
  REQUIRED
}

enum CoursePartState {
  NORMAL
  DOCUMENT_EXPECTED
}

model Project {
  id                    String          @id @default(cuid())
  userId                String?
  title                 String
  sourceType            String          @default("text")
  sourceContent         String          @db.Text
  targetDurationMinutes Int
  audience              String
  tone                  String
  level                 String
  learningObjective     String          @db.Text
  deliveryType          DeliveryType    @default(COURSE_SUMMARY)
  projectKind           ProjectKind     @default(LEGACY_AUDIO)
  responseMode          ResponseMode?
  vocabularyLevel       VocabularyLevel @default(COMMON)
  adaptationMode        AdaptationMode  @default(STANDARD)
  researchMode          ResearchMode    @default(NONE)
  researchUsed          Boolean         @default(false)
  script                String?         @db.Text
  scriptStatus          ProjectStatus   @default(DRAFT)
  contentVersion        Int             @default(1)
  audioStatus           AudioStatus     @default(NOT_GENERATED)
  audioContentVersion   Int?
  audioUrl              String?
  audioFilePath         String?
  audioFormat           String?         @default("mp3")
  audioDurationSeconds  Int?
  audioGeneratedAt      DateTime?
  audioErrorMessage     String?         @db.Text
  errorMessage          String?         @db.Text
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  sources               ProjectSource[]
  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  courseThemeId         String?
  courseTheme           CourseTheme?    @relation(fields: [courseThemeId, userId], references: [id, userId], onDelete: NoAction)
  learningVersions      ProjectVersion[]

  @@unique([id, userId])
  @@index([userId])
  @@index([createdAt])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  sessions     Session[]
  schoolYears  SchoolYear[]
  subjects     Subject[]
  courseThemes CourseTheme[]
  chapters     Chapter[]
  courseParts  CoursePart[]
  sourceAssets SourceAsset[]
  sourceImports SourceImport[]
  sourcePlacements SourcePlacement[]
  extractions SourceExtraction[]
  passages SourcePassage[]
  learningVersions ProjectVersion[]
  passageCitations PassageCitation[]
  learningSessions LearningSession[]
  learningAttempts LearningAttempt[]
  providerUsage ProviderUsage[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  keyHash      String    @id @db.Char(64)
  failureCount Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model ProjectSource {
  id            String   @id @default(cuid())
  projectId     String
  url           String   @db.Text
  title         String?
  domain        String?
  sourceOrder   Int
  citationStart Int?
  citationEnd   Int?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, sourceOrder])
  @@index([projectId])
}

model SchoolYear {
  id        String   @id @default(cuid())
  userId    String
  label     String   @db.VarChar(80)
  startYear Int?
  endYear   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subjects Subject[]

  @@unique([id, userId])
  @@unique([userId, label])
  @@index([userId])
}

model Subject {
  id           String   @id @default(cuid())
  userId       String
  schoolYearId String
  title        String   @db.VarChar(120)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolYear SchoolYear    @relation(fields: [schoolYearId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  themes     CourseTheme[]

  @@unique([id, userId])
  @@unique([userId, schoolYearId, title])
  @@index([userId, schoolYearId])
}

model CourseTheme {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  title     String   @db.VarChar(160)
  orderVersion Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subject  Subject      @relation(fields: [subjectId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  chapters Chapter[]
  parts    CoursePart[]
  projects Project[]
  learningVersions ProjectVersion[]
  learningSessions LearningSession[]

  @@unique([id, userId])
  @@unique([userId, subjectId, title])
  @@index([userId, subjectId])
}

model Chapter {
  id            String   @id @default(cuid())
  userId        String
  courseThemeId String
  title         String   @db.VarChar(160)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseTheme CourseTheme  @relation(fields: [courseThemeId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  parts       CoursePart[]

  @@unique([id, userId])
  @@unique([id, userId, courseThemeId])
  @@unique([userId, courseThemeId, title])
  @@index([userId, courseThemeId])
}

model CoursePart {
  id             String          @id @default(cuid())
  userId         String
  courseThemeId  String
  chapterId      String?
  title          String          @db.VarChar(180)
  referenceLabel String?         @db.VarChar(80)
  sortSegments   Int[]           @default([])
  position       Int
  state          CoursePartState @default(NORMAL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseTheme CourseTheme   @relation(fields: [courseThemeId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  chapter     Chapter?      @relation(fields: [chapterId, userId, courseThemeId], references: [id, userId, courseThemeId], onDelete: NoAction, onUpdate: Cascade)
  placements SourcePlacement[]

  @@unique([id, userId])
  @@index([userId, courseThemeId, position])
  @@index([userId, chapterId])
}

model SourceAsset {
  id         String   @id @default(cuid())
  userId     String
  sha256     String   @db.Char(64)
  storageKey String   @unique @db.VarChar(100)
  mimeType   String   @db.VarChar(100)
  byteSize   Int
  createdAt  DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  imports    SourceImport[]
  placements SourcePlacement[]
  extractions SourceExtraction[]

  @@unique([id, userId])
  @@unique([userId, sha256])
  @@index([userId])
}

model SourceImport {
  id               String   @id @default(cuid())
  userId           String
  sourceAssetId    String
  originalFileName String   @db.VarChar(255)
  declaredMimeType String?  @db.VarChar(100)
  wasDuplicate     Boolean @default(false)
  createdAt        DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceAsset SourceAsset @relation(fields: [sourceAssetId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, sourceAssetId])
  @@index([userId, createdAt])
}

model SourcePlacement {
  id            String   @id @default(cuid())
  userId        String
  coursePartId  String
  sourceAssetId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  coursePart  CoursePart  @relation(fields: [coursePartId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  sourceAsset SourceAsset @relation(fields: [sourceAssetId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([coursePartId, sourceAssetId])
  @@index([userId, coursePartId])
  @@index([userId, sourceAssetId])
}

// Immutable extraction of one PDF page or ODT text/image unit.
model SourceExtraction {
  id String @id @default(cuid())
  userId String
  sourceAssetId String
  unitKey String @db.VarChar(100)
  inputHash String @db.Char(64)
  extractorVersion String @db.VarChar(80)
  method String @db.VarChar(20)
  quality String @db.VarChar(20)
  text String @db.Text
  consentAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAsset SourceAsset @relation(fields: [sourceAssetId, userId], references: [id, userId], onDelete: Cascade)
  passages SourcePassage[]
  @@unique([id, userId])
  @@unique([userId, sourceAssetId, unitKey, inputHash, extractorVersion, method])
}

model SourcePassage {
  id String @id @default(cuid())
  userId String
  extractionId String
  position Int
  start Int
  end Int
  text String @db.Text
  quality String @db.VarChar(20)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  extraction SourceExtraction @relation(fields: [extractionId, userId], references: [id, userId], onDelete: Cascade)
  citations PassageCitation[]
  @@unique([id, userId])
  @@unique([extractionId, position])
}

model ProjectVersion {
  id String @id @default(cuid())
  userId String
  projectId String
  courseThemeId String
  version Int
  mode String @db.VarChar(30)
  sourceFingerprint String @db.Char(64)
  cacheKey String @db.Char(64)
  content Json
  audio Json @default("{}")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  courseTheme CourseTheme @relation(fields: [courseThemeId, userId], references: [id, userId], onDelete: Cascade)
  citations PassageCitation[]
  sessions LearningSession[]
  @@unique([id, userId])
  @@unique([projectId, version])
  @@unique([userId, cacheKey])
}

model PassageCitation {
  id String @id @default(cuid())
  userId String
  projectVersionId String
  passageId String
  elementKey String @db.VarChar(100)
  quote String @db.Text
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectVersion ProjectVersion @relation(fields: [projectVersionId, userId], references: [id, userId], onDelete: Cascade)
  passage SourcePassage @relation(fields: [passageId, userId], references: [id, userId], onDelete: NoAction)
  @@unique([projectVersionId, elementKey, passageId])
}

model LearningSession {
  id String @id @default(cuid())
  userId String
  courseThemeId String
  projectVersionId String
  kind String @db.VarChar(20)
  instruction String? @db.Text
  position Int @default(0)
  correctionRequested Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseTheme CourseTheme @relation(fields: [courseThemeId, userId], references: [id, userId], onDelete: Cascade)
  projectVersion ProjectVersion @relation(fields: [projectVersionId, userId], references: [id, userId], onDelete: Cascade)
  attempts LearningAttempt[]
  @@unique([id, userId])
}

model LearningAttempt {
  id String @id @default(cuid())
  userId String
  sessionId String
  questionIndex Int
  answer String @db.Text
  feedback String @db.Text
  correct Boolean?
  hintsUsed Int @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LearningSession @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  @@index([userId, sessionId, questionIndex])
}

// Allowlisted technical metadata only: never prompts, outputs, files or error bodies.
model ProviderUsage {
  id String @id @default(cuid())
  userId String
  operationKey String @db.Char(64)
  provider String @db.VarChar(30)
  operation String @db.VarChar(30)
  status String @db.VarChar(20)
  inputTokens Int?
  outputTokens Int?
  units Int @default(1)
  durationMs Int?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, operationKey])
}
