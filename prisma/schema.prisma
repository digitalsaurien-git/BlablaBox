generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  SCRIPT_GENERATED
  SCRIPT_FAILED
}

enum AudioStatus {
  NOT_GENERATED
  PENDING
  GENERATED
  FAILED
}

enum DeliveryType {
  IMMERSIVE_STORY
  COURSE_SUMMARY
  MEMORY_AUDIO_CARD
  REVIEW_QA
}

enum ProjectKind {
  LEGACY_AUDIO
  UNDERSTAND_LISTEN
  DICTATE_WRITE
}

enum ResponseMode {
  EXPLAIN
  STORY
  REVIEW
  QUICK
}

enum VocabularyLevel {
  VERY_SIMPLE
  COMMON
  PRECISE
}

enum AdaptationMode {
  STANDARD
  FOCUS
  EASY_READING
  MEMORY
}

enum ResearchMode {
  NONE
  AUTO
  REQUIRED
}

model Project {
  id                    String          @id @default(cuid())
  userId                String?
  title                 String
  sourceType            String          @default("text")
  sourceContent         String          @db.Text
  targetDurationMinutes Int
  audience              String
  tone                  String
  level                 String
  learningObjective     String          @db.Text
  deliveryType          DeliveryType    @default(COURSE_SUMMARY)
  projectKind           ProjectKind     @default(LEGACY_AUDIO)
  responseMode          ResponseMode?
  vocabularyLevel       VocabularyLevel @default(COMMON)
  adaptationMode        AdaptationMode  @default(STANDARD)
  researchMode          ResearchMode    @default(NONE)
  researchUsed          Boolean         @default(false)
  script                String?         @db.Text
  scriptStatus          ProjectStatus   @default(DRAFT)
  contentVersion        Int             @default(1)
  audioStatus           AudioStatus     @default(NOT_GENERATED)
  audioContentVersion   Int?
  audioUrl              String?
  audioFilePath         String?
  audioFormat           String?         @default("mp3")
  audioDurationSeconds  Int?
  audioGeneratedAt      DateTime?
  audioErrorMessage     String?         @db.Text
  errorMessage          String?         @db.Text
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  sources               ProjectSource[]

  @@index([userId])
  @@index([createdAt])
}

model ProjectSource {
  id            String   @id @default(cuid())
  projectId     String
  url           String   @db.Text
  title         String?
  domain        String?
  sourceOrder   Int
  citationStart Int?
  citationEnd   Int?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, sourceOrder])
  @@index([projectId])
}
